{
  "name": "PrioriSea Developer Environment",
  "build": {
    "dockerfile": "../extended.Dockerfile",
    "context": "..",
    "target": "base"
  },
  "postCreateCommand": "'git submodule update --init --recursive'",
  "remoteEnv": {
    "CPATH": "${containerWorkspaceFolder}:${containerWorkspaceFolder}/external/croncpp/include:${containerWorkspaceFolder}/external/tinyexpr",
    "CPLUS_INCLUDE_PATH": "${containerWorkspaceFolder}:${containerWorkspaceFolder}/external/croncpp/include:${containerWorkspaceFolder}/external/tinyexpr"
  }
}
